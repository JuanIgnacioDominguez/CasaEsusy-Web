# URL canónica del sitio (sin barra final). Se usa en canonical, sitemap, Open Graph y links de presupuestos.
NEXT_PUBLIC_SITE_URL=https://www.casaesusy.com.ar

# Base de datos (SQLite/libSQL).
# - Sin definir: archivo local data/casa-esusy.db (desarrollo y VPS).
# - Vercel: base en Turso → DATABASE_URL=libsql://xxx.turso.io y DATABASE_AUTH_TOKEN=...
# DATABASE_URL=file:data/casa-esusy.db
# DATABASE_AUTH_TOKEN=

# Carpeta de imágenes subidas desde el panel (por defecto data/uploads). Tiene que persistir entre deploys.
# UPLOADS_DIR=/var/casa-esusy/uploads

# Primer usuario administrador: se crea al correr `npm run db:setup` si la base no tiene usuarios.
ADMIN_EMAIL=admin@casaesusy.com.ar
ADMIN_PASSWORD=
ADMIN_NAME=Andrea Esusy
# ADMIN_RESET=1   # con ADMIN_EMAIL y ADMIN_PASSWORD, restablece esa contraseña al correr db:setup
