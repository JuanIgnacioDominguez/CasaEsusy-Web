{
  "name": "casa-esusy-web",
  "version": "0.2.0",
  "private": true,
  "description": "Sitio web y panel de Casa Esusy · Decoración integral en Banfield desde 1967",
  "scripts": {
    "dev": "next dev",
    "predev": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "build": "next build",
    "prebuild": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "start": "next start",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "db:demo": "tsx --env-file-if-exists=.env.local scripts/db-demo.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
